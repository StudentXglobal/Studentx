```css
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'Inter', sans-serif;
  color: #f7f8ff;
  background: #07091b;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;

  --bg: #07091b;
  --panel: #10142e;
  --panel-light: #171d3e;
  --primary: #6558f5;
  --primary-light: #8b80ff;
  --text: #f7f8ff;
  --muted: #9ba3c7;
  --border: rgba(255, 255, 255, 0.09);
  --danger: #ff647c;
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  min-height: 100%;
  background: var(--bg);
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
}

body,
button,
input {
  font-family: 'Inter', sans-serif;
}

button,
input {
  font-size: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

button:focus-visible,
input:focus-visible,
a:focus-visible {
  outline: 2px solid var(--primary-light);
  outline-offset: 3px;
}

#root {
  min-height: 100vh;
}

*::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

*::-webkit-scrollbar-thumb {
  background: #30375e;
  border-radius: 10px;
}

::selection {
  color: #fff;
  background: #6558f5;
}
```
